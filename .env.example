# Supabase — copy to .env and fill in your project values
# Never commit .env — it is gitignored. See src/environments/environment.example.ts
# Note: Angular uses src/environments/environment.ts, not Vite env. These vars are for tooling only.

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Legacy Vite prefix kept for compatibility if you use Vite tooling:
# VITE_SUPABASE_URL=$SUPABASE_URL
# VITE_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
